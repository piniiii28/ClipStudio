# Copia este archivo como ".env" y ajusta lo que necesites. Ninguna variable es obligatoria.

# Carpeta donde se guardan videos, transcripciones, exportaciones, modelos y FFmpeg.
# Por defecto: %LOCALAPPDATA%\ClipStudio (fuera de OneDrive, para no sincronizar videos).
# CLIPSTUDIO_DATA_DIR=D:\ClipStudioDatos

# Direccion y puerto del servidor local.
# CLIPSTUDIO_HOST=127.0.0.1
# CLIPSTUDIO_PORT=8765

# Modelo de transcripcion (faster-whisper): tiny, base, small, medium, large-v3.
# Mas grande = mas preciso y mas lento. "small" es un buen equilibrio en CPU.
# CLIPSTUDIO_WHISPER_MODEL=small
# Tipo de computo: int8 (CPU, recomendado), float32, o float16 (solo GPU NVIDIA).
# CLIPSTUDIO_WHISPER_COMPUTE=int8
# Dispositivo: cpu o cuda (cuda solo con GPU NVIDIA y librerias CUDA instaladas).
# CLIPSTUDIO_WHISPER_DEVICE=cpu

# Carpeta de los modelos de transcripcion (por defecto, dentro de la carpeta de datos).
# CLIPSTUDIO_MODELS_DIR=D:\Modelos

# Carpeta de los videos de fondo (gameplay) del encuadre "dividido". Por defecto: dentro de la carpeta de datos.
# CLIPSTUDIO_FONDOS_DIR=D:\Fondos

# Carpeta que contiene ffmpeg.exe y ffprobe.exe si quieres usar una instalacion propia.
# CLIPSTUDIO_FFMPEG_DIR=C:\ffmpeg\bin

# Limites de seguridad.
# CLIPSTUDIO_MAX_UPLOAD_GB=8
# CLIPSTUDIO_MAX_DURATION_MIN=720

# Navegador del que yt-dlp puede leer cookies para videos que exigen sesion (opcional).
# Valores: chrome, edge, firefox. Vacio = sin cookies.
# CLIPSTUDIO_YTDLP_COOKIES_BROWSER=
